<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinAPP.Views.Components.FinnyPetView">

    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
        
        <!-- Облачко мыслей Финни (реплика / подсказка) -->
        <Border x:Name="SpeechBubble"
                BackgroundColor="White"
                Stroke="#8A83D1"
                StrokeThickness="2"
                Padding="12,8"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 16">
            <Border.Shadow>
                <Shadow Brush="#8A83D1" Offset="0,3" Radius="8" Opacity="0.25"/>
            </Border.Shadow>
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="💬" FontSize="16" VerticalOptions="Center"/>
                <Label x:Name="LblSpeech"
                       Text="Привет! Я котик Финни! Нажми на меня 🐾"
                       FontSize="14"
                       FontFamily="MontserratMedium"
                       TextColor="#310F53"
                       MaxLines="2"
                       LineBreakMode="WordWrap"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Контейнер персонажа со слоями и скелетной анимацией -->
        <Grid x:Name="PetContainer"
              HeightRequest="270"
              WidthRequest="230"
              HorizontalOptions="Center"
              VerticalOptions="Center">

            <!-- Золотое свечение для стадии Мастер -->
            <BoxView x:Name="MasterAura"
                     Color="#F59E0B"
                     CornerRadius="115"
                     Opacity="0.25"
                     IsVisible="False"
                     HeightRequest="230"
                     WidthRequest="230"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"/>

            <!-- СЛОЙ 0: Хвостик (ZIndex 0, позади туловища, опорная точка у основания) -->
            <Image x:Name="ImgTail"
                   Source="finny_tail.png"
                   Aspect="AspectFit"
                   WidthRequest="75"
                   HeightRequest="95"
                   AnchorX="0.85"
                   AnchorY="0.85"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   Margin="12, 60, 0, 0"/>

            <!-- СЛОЙ 1: Туловище с ножками и правой лапкой на поясе (ZIndex 1) -->
            <Image x:Name="ImgBody"
                   Source="finny_body.png"
                   Aspect="AspectFit"
                   WidthRequest="165"
                   HeightRequest="195"
                   AnchorX="0.5"
                   AnchorY="1.0"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0, 0, 10, 0"/>

            <!-- СЛОЙ 2: Машущая лапка (ZIndex 2, опорная точка в плечевом суставе) -->
            <Image x:Name="ImgArmWave"
                   Source="finny_arm_wave.png"
                   Aspect="AspectFit"
                   WidthRequest="95"
                   HeightRequest="75"
                   AnchorX="0.15"
                   AnchorY="0.85"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   Margin="0, 0, 6, 48"/>

            <!-- СЛОЙ 3: Голова с ушками и мордочкой (ZIndex 3, опорная точка у шеи) -->
            <Image x:Name="ImgHead"
                   Source="finny_head_happy.png"
                   Aspect="AspectFit"
                   WidthRequest="145"
                   HeightRequest="135"
                   AnchorX="0.5"
                   AnchorY="0.95"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0, 0, 10, 0"/>

            <!-- СЛОЙ 4: Накладной аксессуар (очки, шапочка, корона) -->
            <Image x:Name="ImgAccessory"
                   Source="acc_sunglasses.png"
                   Aspect="AspectFit"
                   WidthRequest="110"
                   HeightRequest="60"
                   AnchorX="0.5"
                   AnchorY="0.95"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0, 18, 10, 0"
                   IsVisible="False"/>

            <!-- Бейдж стадии роста в левом верхнем углу -->
            <Border BackgroundColor="#520978"
                    Stroke="#FF0053"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 12"
                    Padding="6,3"
                    HorizontalOptions="Start"
                    VerticalOptions="Start">
                <Label x:Name="LblStageBadge"
                       Text="🐾 Малыш"
                       FontSize="11"
                       FontFamily="MontserratBold"
                       TextColor="White"/>
            </Border>

            <!-- Жест нажатия на питомца для интерактива -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPetTapped"/>
            </Grid.GestureRecognizers>
        </Grid>
        
    </VerticalStackLayout>

</ContentView>
