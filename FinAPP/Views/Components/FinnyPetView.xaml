<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinAPP.Views.Components.FinnyPetView">

    <Grid x:Name="PetContainer"
          WidthRequest="165"
          HeightRequest="240"
          HorizontalOptions="Start"
          VerticalOptions="Center"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnPetTapped"/>
        </Grid.GestureRecognizers>

        <!-- Золотое свечение для высшей стадии Мастер -->
        <Border x:Name="MasterAura"
                BackgroundColor="#F59E0B"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 100"
                Opacity="0.25"
                IsVisible="False"
                HeightRequest="200"
                WidthRequest="200"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

        <!-- Сменная платформа / пьедестал под ногами Финни (расположена чуть ниже, чтобы лапки стояли на ней) -->
        <Border x:Name="PlatformBase"
                HeightRequest="20"
                WidthRequest="155"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="1.5"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,0">
            <Border.Shadow>
                <Shadow x:Name="PlatformShadow" Brush="#00E676" Radius="10" Opacity="0.6" Offset="0,2"/>
            </Border.Shadow>
            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                <BoxView x:Name="PlatformBg" Color="#2E7D32" HorizontalOptions="Fill" VerticalOptions="Fill" />
                <Label x:Name="PlatformDecor"
                       Text="✤   ✤   ✤   ✤   ✤   ✤   ✤"
                       TextColor="#E8F5E9"
                       FontSize="11"
                       FontFamily="MontserratBold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- WebView для аппаратного проигрывания анимированных GIF (Android / iOS / Windows) -->
        <WebView x:Name="PetWebView"
                 BackgroundColor="Transparent"
                 InputTransparent="True"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Margin="0,0,0,16"/>

        <!-- Резервное нативное изображение на случай непредвиденных сбоев WebView -->
        <Image x:Name="ImgPetFallback"
               IsAnimationPlaying="True"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False"
               InputTransparent="True"
               Margin="0,0,0,16"/>

        <!-- Накладной рабочий стол поверх нижней части персонажа (ноги и лапки за столом) -->
        <Image x:Name="ImgDeskOverlay"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="End"
               HeightRequest="115"
               WidthRequest="165"
               InputTransparent="True"
               IsVisible="False"
               Margin="0,0,0,10"/>

        <!-- Невидимый слой для 100% надежного перехвата тапов по всей площади персонажа -->
        <Border x:Name="TouchOverlayBorder"
                BackgroundColor="#01000000"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="False"
                ZIndex="50">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPetTapped"/>
            </Border.GestureRecognizers>
        </Border>

        <!-- Бейдж стадии роста в левом верхнем углу -->
        <Border BackgroundColor="#520978"
                Stroke="#FF0053"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="6,3"
                Margin="4,4,0,0"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                InputTransparent="True">
            <Label x:Name="LblStageBadge"
                   Text="Малыш (1 ст.)"
                   FontSize="10"
                   FontFamily="MontserratBold"
                   TextColor="White"/>
        </Border>
    </Grid>

</ContentView>
