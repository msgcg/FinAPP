<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinAPP.Views.Components.FinnyPetView">

    <Grid x:Name="PetContainer"
          WidthRequest="165"
          HeightRequest="240"
          HorizontalOptions="Start"
          VerticalOptions="Center">

        <!-- Золотое свечение для высшей стадии Мастер -->
        <Border x:Name="MasterAura"
                BackgroundColor="#F59E0B"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 100"
                Opacity="0.25"
                IsVisible="False"
                HeightRequest="200"
                WidthRequest="200"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

        <!-- Сменная платформа / пьедестал под ногами Финни -->
        <Border x:Name="PlatformBase"
                HeightRequest="24"
                WidthRequest="155"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1.5"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,2">
            <Border.Shadow>
                <Shadow x:Name="PlatformShadow" Brush="#00E676" Radius="10" Opacity="0.6" Offset="0,2"/>
            </Border.Shadow>
            <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                <BoxView x:Name="PlatformBg" Color="#2E7D32" HorizontalOptions="Fill" VerticalOptions="Fill" />
                <Label x:Name="PlatformDecor"
                       Text="✤  ПОЛЯНКА  ✤"
                       TextColor="#E8F5E9"
                       FontSize="9"
                       FontFamily="MontserratBold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- WebView для аппаратного проигрывания анимированных GIF (Android / iOS / Windows) -->
        <WebView x:Name="PetWebView"
                 BackgroundColor="Transparent"
                 InputTransparent="True"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Margin="0,0,0,6"/>

        <!-- Резервное нативное изображение на случай непредвиденных сбоев WebView -->
        <Image x:Name="ImgPetFallback"
               IsAnimationPlaying="True"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False"
               InputTransparent="True"
               Margin="0,0,0,6"/>

        <!-- Невидимый прозрачный слой для 100% надежного перехвата тапов по всей площади персонажа -->
        <BoxView BackgroundColor="Transparent"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPetTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Бейдж стадии роста в левом верхнем углу -->
        <Border BackgroundColor="#520978"
                Stroke="#FF0053"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="6,3"
                Margin="4,4,0,0"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                InputTransparent="True">
            <Label x:Name="LblStageBadge"
                   Text="Малыш (1 ст.)"
                   FontSize="10"
                   FontFamily="MontserratBold"
                   TextColor="White"/>
        </Border>
    </Grid>

</ContentView>
