<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinAPP.Views.Components.FinnyPetView">

    <Grid x:Name="PetContainer"
          WidthRequest="165"
          HeightRequest="240"
          HorizontalOptions="Start"
          VerticalOptions="Center">

        <!-- Золотое свечение для высшей стадии Мастер -->
        <Border x:Name="MasterAura"
                BackgroundColor="#F59E0B"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 100"
                Opacity="0.25"
                IsVisible="False"
                HeightRequest="200"
                WidthRequest="200"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

        <!-- WebView для аппаратного проигрывания анимированных GIF (Android / iOS / Windows) -->
        <WebView x:Name="PetWebView"
                 BackgroundColor="Transparent"
                 InputTransparent="True"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"/>

        <!-- Резервное нативное изображение на случай непредвиденных сбоев WebView -->
        <Image x:Name="ImgPetFallback"
               IsAnimationPlaying="True"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="False"
               InputTransparent="True"/>

        <!-- Накладной аксессуар (очки, шапочка, корона) поверх котика -->
        <Image x:Name="ImgAccessory"
               Source="acc_sunglasses.png"
               Aspect="AspectFit"
               WidthRequest="85"
               HeightRequest="50"
               AnchorX="0.5"
               AnchorY="0.95"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0, 16, 0, 0"
               IsVisible="False"
               InputTransparent="True"/>

        <!-- Невидимый прозрачный слой для 100% надежного перехвата тапов по всей площади персонажа -->
        <BoxView BackgroundColor="Transparent"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPetTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Бейдж стадии роста в левом верхнем углу -->
        <Border BackgroundColor="#520978"
                Stroke="#FF0053"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="6,3"
                Margin="4,4,0,0"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                InputTransparent="True">
            <Label x:Name="LblStageBadge"
                   Text="Малыш (1 ст.)"
                   FontSize="10"
                   FontFamily="MontserratBold"
                   TextColor="White"/>
        </Border>
    </Grid>

</ContentView>
