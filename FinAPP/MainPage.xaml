                                <Border BackgroundColor="#10B981" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" InputTransparent="False">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image Source="ic_gift.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
