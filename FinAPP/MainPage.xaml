                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAgeJuniorClicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border x:Name="BtnParentAgeSenior" Grid.Column="1" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="38" InputTransparent="False">
                                        <Label x:Name="LblParentAgeSenior" Text="🧑 9–11 лет (3–5 кл)" TextColor="#520978" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAgeSeniorClicked"/></Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                                
                                <Border BackgroundColor="#F3E8FF" Stroke="#D8B4FE" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="🎮 Демо-режим симуляции" FontFamily="MontserratBold" FontSize="13" TextColor="#520978"/>
