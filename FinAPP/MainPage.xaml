<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:FinAPP.Views.Components"
             x:Class="FinAPP.MainPage"
             BackgroundColor="#F5F6FA"
             Title="FinAPP">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="14">

            <!-- ВЕРХНЯЯ ПАНЕЛЬ: Брендинг, Демо-режим и доступность -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="FinAPP"
                           FontFamily="MontserratBold"
                           FontSize="22"
                           TextColor="#520978"
                           VerticalOptions="Center"/>
                    <Border x:Name="BadgeDemo"
                            IsVisible="False"
                            BackgroundColor="#FF0053"
                            StrokeThickness="0"
                            Padding="8,2"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Center">
                        <Label Text="ДЕМО"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="11"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Кастомизация платформ и гардероба -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Border x:Name="BtnCustomizer"
                            BackgroundColor="#EBE9F8"
                            StrokeThickness="0"
                            HeightRequest="42"
                            WidthRequest="42"
                            StrokeShape="RoundRectangle 21"
                            InputTransparent="False">
                        <Image Source="ic_gift.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomizerClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ТУМБЛЕР ВОЗРАСТА (7–8 ЛЕТ / 9–11 ЛЕТ) -->
            <Border BackgroundColor="#F3F0FA"
                    Stroke="#D8D2E8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="3"
                    HorizontalOptions="Center"
                    Margin="0, 0, 0, 4">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                    <!-- 7–8 лет -->
                    <Border x:Name="BtnAgeJunior"
                            Grid.Column="0"
                            BackgroundColor="#520978"
                            StrokeThickness="0"
                            Padding="16,6"
                            StrokeShape="RoundRectangle 12"
                            InputTransparent="False">
                        <Label x:Name="LblAgeJunior"
                               Text="7–8 лет"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgeJuniorClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- 9–11 лет -->
                    <Border x:Name="BtnAgeSenior"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="16,6"
                            StrokeShape="RoundRectangle 12"
                            InputTransparent="False">
                        <Label x:Name="LblAgeSenior"
                               Text="9–11 лет"
                               TextColor="#6B7280"
                               FontFamily="MontserratMedium"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgeSeniorClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- 1. ОБЛАЧКО МЫСЛЕЙ ФИННИ (Яркие, живые советы и финансовые лайфхаки) -->
            <Border x:Name="SpeechBubble"
                    BackgroundColor="White"
                    Stroke="#8A83D1"
                    StrokeThickness="2"
                    Padding="14,10"
                    Margin="0,0"
                    HorizontalOptions="Fill"
                    StrokeShape="RoundRectangle 18"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#8A83D1" Offset="0,4" Radius="10" Opacity="0.22"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSpeechBubbleTapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Image Grid.Column="0"
                           Source="ic_speech_bubble.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           x:Name="LblSpeech"
                           Text="Привет! Я котик Финни! Нажми на меня, чтобы узнать секреты сбережений!"
                           FontSize="13"
                           FontFamily="MontserratMedium"
                           TextColor="#310F53"
                           LineBreakMode="WordWrap"
                           MaxLines="3"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- 2. СЕКЦИЯ ДАШБОРДА: ФИННИ СЛЕВА + ПОКАЗАТЕЛИ КОШЕЛЬКА СПРАВА -->
            <Grid ColumnDefinitions="165,*" ColumnSpacing="8" Margin="-16,2,0,2">
                
                <!-- Финни до упора влево (без внешней рамки) -->
                <comp:FinnyPetView x:Name="PetView"
                                   Grid.Column="0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center"/>

                <!-- Карточка финансовых балансов и периода справа от Финни -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,10"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#520978" Offset="0,4" Radius="12" Opacity="0.09"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">
                        
                        <!-- Заголовок: имя питомца и номер периода -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label x:Name="LblPetHeader"
                                   Text="Питомец Финни"
                                   FontFamily="MontserratBold"
                                   FontSize="14"
                                   TextColor="#1C1D22"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#F3E8FF"
                                    Stroke="#8A83D1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="6,2">
                                <Label x:Name="LblPeriodHeader"
                                       Text="Период #1"
                                       FontFamily="MontserratBold"
                                       FontSize="11"
                                       TextColor="#520978"/>
                            </Border>
                        </Grid>

                        <!-- Баланс: Кошелёк -->
                        <Border BackgroundColor="#F8F7FD"
                                Stroke="#8A83D1"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTransferMoneyClicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                <Border BackgroundColor="#EBE9F8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        VerticalOptions="Center">
                                    <Image Source="ic_stat_balance.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="КОШЕЛЁК"
                                           FontFamily="MontserratBold"
                                           FontSize="10"
                                           TextColor="#6B7280"/>
                                    <Label x:Name="LblBalance"
                                           Text="400 монет"
                                           FontFamily="MontserratBold"
                                           FontSize="14"
                                           TextColor="#310F53"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Баланс: Копилка -->
                        <Border BackgroundColor="#FDF2F8"
                                Stroke="#F472B6"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTransferMoneyClicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                <Border BackgroundColor="#FCE7F3"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        VerticalOptions="Center">
                                    <Image Source="ic_stat_savings.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="В КОПИЛКЕ"
                                           FontFamily="MontserratBold"
                                           FontSize="10"
                                           TextColor="#9D174D"/>
                                    <Label x:Name="LblSavings"
                                           Text="100 монет"
                                           FontFamily="MontserratBold"
                                           FontSize="14"
                                           TextColor="#BE185D"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Кнопка быстрого двустороннего перевода -->
                        <Border BackgroundColor="#520978"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,7"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTransferMoneyClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="⇄ Перевести"
                                   TextColor="White"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 3. ИНДИКАТОРЫ СЫТОСТИ И НАСТРОЕНИЯ -->
            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="12,10">
                <Border.Shadow>
                    <Shadow Brush="#520978" Offset="0,3" Radius="8" Opacity="0.06"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        
                        <!-- Сытость (зависит от обязательных расходов) -->
                        <Border BackgroundColor="#F0FDF4"
                                Stroke="#86EFAC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Image Source="ic_stat_hunger.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Сытость"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#166534"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="LblHungerVal"
                                           Grid.Column="2"
                                           Text="90%"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#166534"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <ProgressBar x:Name="BarHunger"
                                             Progress="0.9"
                                             ProgressColor="#10B981"
                                             HeightRequest="6"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Настроение (зависит от желаний и заданий) -->
                        <Border BackgroundColor="#FDF2F8"
                                Stroke="#FBCFE8"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Image Source="ic_stat_mood.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Настроение"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#9D174D"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="LblMoodVal"
                                           Grid.Column="2"
                                           Text="90%"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#9D174D"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <ProgressBar x:Name="BarMood"
                                             Progress="0.9"
                                             ProgressColor="#FC3777"
                                             HeightRequest="6"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Текстовое объяснение причины состояния (ТЗ п. 2.5.10) -->
                    <Label x:Name="LblStatusExplanation"
                           Text="Финни сыт, доволен и гордится твоим грамотным бюджетом!"
                           FontFamily="MontserratMedium"
                           FontSize="11"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- 4. ИНТЕРАКТИВНАЯ КАРТОЧКА ФИНАНСОВОЙ ЦЕЛИ -->
            <Border BackgroundColor="#520978"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="14,12"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#520978" Offset="0,4" Radius="12" Opacity="0.22"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoalsClicked"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Image x:Name="ImgGoalCard" Source="ic_goal_scooter.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" x:Name="LblGoalTitle"
                               Text="Цель: Спортивный трюковой самокат"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" x:Name="LblGoalProgressText"
                               Text="100 / 350 монет (28%)"
                               TextColor="#FFD6E4"
                               FontFamily="MontserratMedium"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </Grid>

                    <ProgressBar x:Name="BarGoal"
                                 Progress="0.28"
                                 ProgressColor="#FF0053"
                                 HeightRequest="8"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Label x:Name="LblGoalEstimatedTime"
                               Text="До цели осталось ~5 периодов"
                               TextColor="#FFD6E4"
                               FontFamily="MontserratMedium"
                               FontSize="11"/>
                        <Label Grid.Column="1"
                               Text="Выбрать / пополнить ➜"
                               TextColor="#FCD34D"
                               FontFamily="MontserratBold"
                               FontSize="11"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- БЫСТРАЯ НАВИГАЦИЯ ПО РАЗДЕЛАМ (Кнопки >= 48dp по п. 3.6 ТЗ) -->
            <Label Text="Финансовые действия"
                   FontFamily="MontserratBold"
                   FontSize="16"
                   TextColor="#1C1D22"
                   Margin="4,2,0,0"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">

                <!-- 1. План бюджета -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Image Source="ic_nav_budget.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="План бюджета"
                               TextColor="#520978"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBudgetClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 2. Финансовые задания -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Image Source="ic_nav_tasks.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Задания (+монеты)"
                               TextColor="#FF0053"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTasksClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 3. Магазин -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Image Source="ic_nav_shop.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Магазин заботы"
                               TextColor="#059669"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShopClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 4. Копилка и цели -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Image Source="ic_nav_goals.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Копилка и цели"
                               TextColor="#4F46E5"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalsClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 5. Словарь и рост -->
                <Border Grid.Row="2" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Image Source="ic_nav_glossary.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Словарь и рост"
                               TextColor="#D97706"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGlossaryClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 6. Родителям -->
                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Image Source="ic_nav_parent.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Родителям"
                               TextColor="#4B5563"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnParentClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 7. ДЕМО: Следующий период -->
                <Border x:Name="CardDemoNextPeriod"
                        IsVisible="False"
                        Grid.Row="3" Grid.ColumnSpan="2"
                        BackgroundColor="#310F53"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="54"
                        Padding="14,0"
                        InputTransparent="False">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_nav_next.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                        <Label Text="ДЕМО: Завершить период и перейти дальше"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextPeriodClicked"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>

            <!-- Подвал с логотипами и статусом -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,10,0,16">
                <Label Text="Департамент финансов Москвы • ЛЦТ 2026"
                       FontFamily="MontserratMedium"
                       FontSize="11"
                       TextColor="#9CA3AF"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <!-- ================================================================= -->
    <!-- ИНТЕРАКТИВНЫЙ ВНУТРИСТРАНИЧНЫЙ МОДАЛЬНЫЙ ОВЕРЛЕЙ (In-Page Modals)  -->
    <!-- ================================================================= -->
    <Grid x:Name="ModalOverlay"
          BackgroundColor="#AA000000"
          IsVisible="False"
          Opacity="0"
          InputTransparent="False">

        <!-- Клик по затемненной подложке закрывает окно -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCloseModalClicked"/>
        </Grid.GestureRecognizers>

        <!-- Центральная карточка модалки -->
        <Border x:Name="ModalCard"
                BackgroundColor="White"
                Stroke="#8A83D1"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 24"
                Margin="16,24"
                Padding="18,16"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="440"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">

                <!-- Шапка модального окна -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label x:Name="LblModalHeader"
                           Text="Модальное окно"
                           FontFamily="MontserratBold"
                           FontSize="17"
                           TextColor="#310F53"
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#F3F4F6"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="34"
                            WidthRequest="34"
                            Padding="0"
                            InputTransparent="False">
                        <Label Text="✕"
                               FontSize="15"
                               FontFamily="MontserratBold"
                               TextColor="#4B5563"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseModalClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="#E5E7EB"/>

                <!-- СКРОЛЛИРУЕМАЯ ОБЛАСТЬ КОНТЕНТА МОДАЛКИ -->
                <ScrollView MaximumHeightRequest="480">
                    <VerticalStackLayout Spacing="12">

                        <!-- A. МОДАЛКА: ПЛАН БЮДЖЕТА (3 КОНВЕРТА) -->
                        <VerticalStackLayout x:Name="PanelBudget" Spacing="12" IsVisible="False">
                            <Border BackgroundColor="#F3E8FF" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
