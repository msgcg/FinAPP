<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:FinAPP.Views.Components"
             x:Class="FinAPP.MainPage"
             BackgroundColor="#F5F6FA"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="14">

            <!-- ВЕРХНЯЯ ПАНЕЛЬ: Брендинг, Демо-режим и доступность -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="FinAPP"
                           FontFamily="MontserratBold"
                           FontSize="22"
                           TextColor="#520978"
                           VerticalOptions="Center"/>
                    <Border x:Name="BadgeDemo"
                            IsVisible="False"
                            BackgroundColor="#FF0053"
                            StrokeThickness="0"
                            Padding="8,2"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Center">
                        <Label Text="ДЕМО"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="11"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Верхние кнопки: Онбординг, Аналитика, Кастомизация, Звук -->
                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                    <!-- Кнопка интерактивного обучения -->
                    <Border x:Name="BtnOnboarding"
                            BackgroundColor="#FEF3C7"
                            Stroke="#F59E0B"
                            StrokeThickness="1.5"
                            HeightRequest="38"
                            WidthRequest="38"
                            StrokeShape="RoundRectangle 19"
                            InputTransparent="False">
                        <Image Source="ic_speech_bubble.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOnboardingHeaderClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Кнопка аналитики и истории периодов -->
                    <Border x:Name="BtnAnalytics"
                            BackgroundColor="#059669"
                            Stroke="#047857"
                            StrokeThickness="1.5"
                            HeightRequest="38"
                            WidthRequest="38"
                            StrokeShape="RoundRectangle 19"
                            InputTransparent="False">
                        <Image Source="ic_stat_balance.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAnalyticsClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Кнопка гардероба и подиума -->
                    <Border x:Name="BtnCustomizer"
                            BackgroundColor="#7C3AED"
                            Stroke="#6D28D9"
                            StrokeThickness="1.5"
                            HeightRequest="38"
                            WidthRequest="38"
                            StrokeShape="RoundRectangle 19"
                            InputTransparent="False">
                        <Image Source="ic_gift.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomizerClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Кнопка управления звуком и музыкой -->
                    <Border x:Name="BtnAudioQuick"
                            BackgroundColor="#EBE9F8"
                            Stroke="#8A83D1"
                            StrokeThickness="1.5"
                            HeightRequest="38"
                            WidthRequest="38"
                            StrokeShape="RoundRectangle 19"
                            InputTransparent="False">
                        <Image x:Name="ImgAudioQuick"
                               Source="ic_sound_on.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAudioQuickClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ТУМБЛЕР ВОЗРАСТА (7–8 ЛЕТ / 9–11 ЛЕТ) -->
            <Border BackgroundColor="#F3F0FA"
                    Stroke="#D8D2E8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="3"
                    HorizontalOptions="Center"
                    Margin="0, 0, 0, 4">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                    <!-- 7–8 лет -->
                    <Border x:Name="BtnAgeJunior"
                            Grid.Column="0"
                            BackgroundColor="#520978"
                            StrokeThickness="0"
                            Padding="16,6"
                            StrokeShape="RoundRectangle 12"
                            InputTransparent="False">
                        <Label x:Name="LblAgeJunior"
                               Text="7–8 лет"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgeJuniorClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- 9–11 лет -->
                    <Border x:Name="BtnAgeSenior"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="16,6"
                            StrokeShape="RoundRectangle 12"
                            InputTransparent="False">
                        <Label x:Name="LblAgeSenior"
                               Text="9–11 лет"
                               TextColor="#6B7280"
                               FontFamily="MontserratMedium"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgeSeniorClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- 1. ОБЛАЧКО МЫСЛЕЙ ФИННИ (Яркие, живые советы и финансовые лайфхаки) -->
            <Border x:Name="SpeechBubble"
                    BackgroundColor="White"
                    Stroke="#8A83D1"
                    StrokeThickness="2"
                    Padding="14,10"
                    Margin="0,0"
                    HorizontalOptions="Fill"
                    StrokeShape="RoundRectangle 18"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#8A83D1" Offset="0,4" Radius="10" Opacity="0.22"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSpeechBubbleTapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Image Grid.Column="0"
                           Source="ic_speech_bubble.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           x:Name="LblSpeech"
                           Text="Привет! Я котик Финни! Нажми на меня, чтобы узнать секреты сбережений!"
                           FontSize="13"
                           FontFamily="MontserratMedium"
                           TextColor="#310F53"
                           LineBreakMode="WordWrap"
                           MaxLines="3"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- 2. СЕКЦИЯ ДАШБОРДА: ФИННИ СЛЕВА + ПОКАЗАТЕЛИ КОШЕЛЬКА СПРАВА -->
            <Grid ColumnDefinitions="165,*" ColumnSpacing="8" Margin="-16,2,0,2">
                
                <!-- Финни до упора влево + всплывающий бейдж эффекта покупки -->
                <Grid Grid.Column="0" WidthRequest="165" HeightRequest="240" HorizontalOptions="Start" VerticalOptions="Center">
                    <comp:FinnyPetView x:Name="PetView"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center"/>
                    
                    <Border x:Name="BorderPurchaseToast"
                            BackgroundColor="#10B981"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="8,5"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Opacity="0"
                            IsVisible="False"
                            InputTransparent="True"
                            ZIndex="99">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Image Source="ic_heart.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Label x:Name="LblPurchaseToast"
                                   Text="+25 сытости!"
                                   TextColor="White"
                                   FontSize="11"
                                   FontFamily="MontserratBold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Карточка финансовых балансов и периода справа от Финни -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,10"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#520978" Offset="0,4" Radius="12" Opacity="0.09"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8">
                        
                        <!-- Заголовок: имя питомца и номер периода -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label x:Name="LblPetHeader"
                                   Text="Питомец Финни"
                                   FontFamily="MontserratBold"
                                   FontSize="14"
                                   TextColor="#1C1D22"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#F3E8FF"
                                    Stroke="#8A83D1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="6,2">
                                <Label x:Name="LblPeriodHeader"
                                       Text="Период #1"
                                       FontFamily="MontserratBold"
                                       FontSize="11"
                                       TextColor="#520978"/>
                            </Border>
                        </Grid>

                        <!-- Баланс: Кошелёк -->
                        <Border BackgroundColor="#F8F7FD"
                                Stroke="#8A83D1"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTransferMoneyClicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                <Border BackgroundColor="#520978"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        VerticalOptions="Center">
                                    <Image Source="ic_stat_balance.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="КОШЕЛЁК"
                                           FontFamily="MontserratBold"
                                           FontSize="10"
                                           TextColor="#6B7280"/>
                                    <Label x:Name="LblBalance"
                                           Text="400 монет"
                                           FontFamily="MontserratBold"
                                           FontSize="14"
                                           TextColor="#310F53"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Баланс: Копилка -->
                        <Border BackgroundColor="#FDF2F8"
                                Stroke="#F472B6"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTransferMoneyClicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                <Border BackgroundColor="#BE185D"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        VerticalOptions="Center">
                                    <Image Source="ic_stat_savings.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="В КОПИЛКЕ"
                                           FontFamily="MontserratBold"
                                           FontSize="10"
                                           TextColor="#9D174D"/>
                                    <Label x:Name="LblSavings"
                                           Text="100 монет"
                                           FontFamily="MontserratBold"
                                           FontSize="14"
                                           TextColor="#BE185D"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Кнопка быстрого двустороннего перевода -->
                        <Border BackgroundColor="#520978"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,7"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTransferMoneyClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="⇄ Перевести"
                                   TextColor="White"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 3. ИНДИКАТОРЫ СЫТОСТИ И НАСТРОЕНИЯ -->
            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="12,10">
                <Border.Shadow>
                    <Shadow Brush="#520978" Offset="0,3" Radius="8" Opacity="0.06"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        
                        <!-- Сытость (зависит от обязательных расходов) -->
                        <Border BackgroundColor="#F0FDF4"
                                Stroke="#86EFAC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Image Source="ic_stat_hunger.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Сытость"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#166534"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="LblHungerVal"
                                           Grid.Column="2"
                                           Text="90%"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#166534"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <ProgressBar x:Name="BarHunger"
                                             Progress="0.9"
                                             ProgressColor="#10B981"
                                             HeightRequest="6"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Настроение (зависит от желаний и заданий) -->
                        <Border BackgroundColor="#FDF2F8"
                                Stroke="#FBCFE8"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,6">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Image Source="ic_stat_mood.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Настроение"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#9D174D"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="LblMoodVal"
                                           Grid.Column="2"
                                           Text="90%"
                                           FontFamily="MontserratBold"
                                           FontSize="12"
                                           TextColor="#9D174D"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <ProgressBar x:Name="BarMood"
                                             Progress="0.9"
                                             ProgressColor="#FC3777"
                                             HeightRequest="6"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Текстовое объяснение причины состояния (ТЗ п. 2.5.10) -->
                    <Label x:Name="LblStatusExplanation"
                           Text="Финни сыт, доволен и гордится твоим грамотным бюджетом!"
                           FontFamily="MontserratMedium"
                           FontSize="11"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- 4. ИНТЕРАКТИВНАЯ КАРТОЧКА ФИНАНСОВОЙ ЦЕЛИ -->
            <Border BackgroundColor="#520978"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="14,12"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="#520978" Offset="0,4" Radius="12" Opacity="0.22"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoalsClicked"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Image x:Name="ImgGoalCard" Source="ic_goal_scooter.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Grid.Column="1" x:Name="LblGoalTitle"
                               Text="Цель: Спортивный трюковой самокат"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" x:Name="LblGoalProgressText"
                               Text="100 / 350 монет (28%)"
                               TextColor="#FFD6E4"
                               FontFamily="MontserratMedium"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </Grid>

                    <ProgressBar x:Name="BarGoal"
                                 Progress="0.28"
                                 ProgressColor="#FF0053"
                                 HeightRequest="8"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Label x:Name="LblGoalEstimatedTime"
                               Text="До цели осталось ~5 периодов"
                               TextColor="#FFD6E4"
                               FontFamily="MontserratMedium"
                               FontSize="11"/>
                        <Label Grid.Column="1"
                               Text="Выбрать / пополнить ➜"
                               TextColor="#FCD34D"
                               FontFamily="MontserratBold"
                               FontSize="11"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- БЫСТРАЯ НАВИГАЦИЯ ПО РАЗДЕЛАМ (Кнопки >= 48dp по п. 3.6 ТЗ) -->
            <Label Text="Финансовые действия"
                   FontFamily="MontserratBold"
                   FontSize="16"
                   TextColor="#1C1D22"
                   Margin="4,2,0,0"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">

                <!-- 1. План бюджета -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="10,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#F3E8FF" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Image Source="ic_nav_budget.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1" Text="План бюджета"
                               TextColor="#520978"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBudgetClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 2. Финансовые задания -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="10,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#FFE4E6" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Image Source="ic_nav_tasks.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1" Text="Задания (+монеты)"
                               TextColor="#FF0053"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTasksClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 3. Магазин -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="10,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#DCFCE7" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Image Source="ic_nav_shop.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1" Text="Магазин заботы"
                               TextColor="#059669"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShopClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 4. Копилка и цели -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="10,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#E0E7FF" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Image Source="ic_nav_goals.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1" Text="Копилка и цели"
                               TextColor="#4F46E5"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalsClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 5. Словарь и рост -->
                <Border Grid.Row="2" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="10,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#FEF3C7" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Image Source="ic_nav_glossary.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1" Text="Словарь и рост"
                               TextColor="#D97706"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGlossaryClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 6. Родителям -->
                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="10,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Image Source="ic_nav_parent.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1" Text="Родителям"
                               TextColor="#4B5563"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnParentClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 7. ДЕМО: Следующий период -->
                <Border x:Name="CardDemoNextPeriod"
                        IsVisible="False"
                        Grid.Row="3" Grid.ColumnSpan="2"
                        BackgroundColor="#310F53"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="54"
                        Padding="14,0"
                        InputTransparent="False">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_nav_next.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                        <Label Text="ДЕМО: Завершить период и перейти дальше"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextPeriodClicked"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>

            <!-- Подвал с логотипами и статусом -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,10,0,16">
                <Label Text="Департамент финансов Москвы • ЛЦТ 2026"
                       FontFamily="MontserratMedium"
                       FontSize="11"
                       TextColor="#9CA3AF"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <!-- ================================================================= -->
    <!-- ИНТЕРАКТИВНЫЙ ВНУТРИСТРАНИЧНЫЙ МОДАЛЬНЫЙ ОВЕРЛЕЙ (In-Page Modals)  -->
    <!-- ================================================================= -->
    <Grid x:Name="ModalOverlay"
          BackgroundColor="#AA000000"
          IsVisible="False"
          Opacity="0"
          InputTransparent="False">

        <!-- Клик по затемненной подложке закрывает окно -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCloseModalClicked"/>
        </Grid.GestureRecognizers>

        <!-- Центральная карточка модалки -->
        <Border x:Name="ModalCard"
                BackgroundColor="White"
                Stroke="#8A83D1"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 24"
                Margin="16,24"
                Padding="18,16"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="440"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">

                <!-- Шапка модального окна -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label x:Name="LblModalHeader"
                           Text="Модальное окно"
                           FontFamily="MontserratBold"
                           FontSize="17"
                           TextColor="#310F53"
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#F3F4F6"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="34"
                            WidthRequest="34"
                            Padding="0"
                            InputTransparent="False">
                        <Label Text="✕"
                               FontSize="15"
                               FontFamily="MontserratBold"
                               TextColor="#4B5563"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseModalClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="#E5E7EB"/>

                <!-- СКРОЛЛИРУЕМАЯ ОБЛАСТЬ КОНТЕНТА МОДАЛКИ -->
                <ScrollView MaximumHeightRequest="480">
                    <VerticalStackLayout Spacing="12">

                        <!-- A. МОДАЛКА: ПЛАН БЮДЖЕТА (3 КОНВЕРТА) -->
                        <VerticalStackLayout x:Name="PanelBudget" Spacing="12" IsVisible="False">
                            <!-- Адаптивная шапка дохода и остатка: раздельные карточки (гарантия от наложения) -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border BackgroundColor="#F3E8FF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ДОХОД" FontFamily="MontserratBold" FontSize="10" TextColor="#6B7280"/>
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Image Source="ic_stat_balance.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                                            <Label x:Name="LblBudgetIncome" Text="500 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#520978" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Border x:Name="BorderBudgetRemaining" Grid.Column="1" BackgroundColor="#FFE4E6" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label x:Name="LblBudgetRemainingTitle" Text="ОСТАЛОСЬ" FontFamily="MontserratBold" FontSize="10" TextColor="#6B7280"/>
                                        <Label x:Name="LblBudgetRemaining" Text="0 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#FF0053" VerticalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Круговая диаграмма структуры бюджета (Donut Chart) -->
                            <Border BackgroundColor="#F8F7FD" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="10,8">
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="12" VerticalOptions="Center">
                                    <GraphicsView x:Name="GvBudgetDonut"
                                                  HeightRequest="100"
                                                  WidthRequest="100"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="Структура бюджета:" FontFamily="MontserratBold" FontSize="11" TextColor="#520978"/>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <BoxView Color="#10B981" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center"/>
                                            <Label x:Name="LblLegendOblig" Text="Обязательные: 250" FontSize="10" FontFamily="MontserratMedium" TextColor="#374151" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <BoxView Color="#8B5CF6" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center"/>
                                            <Label x:Name="LblLegendDisc" Text="Желания: 150" FontSize="10" FontFamily="MontserratMedium" TextColor="#374151" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <BoxView Color="#F59E0B" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center"/>
                                            <Label x:Name="LblLegendSav" Text="В копилку: 100" FontSize="10" FontFamily="MontserratMedium" TextColor="#374151" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Конверт 1: Обязательные -->
                            <Border BackgroundColor="#F0FDF4" Stroke="#86EFAC" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Border BackgroundColor="#166534" StrokeShape="RoundRectangle 6" WidthRequest="26" HeightRequest="26" Padding="4" VerticalOptions="Center">
                                            <Image Source="ic_stat_hunger.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="1. Обязательные расходы (еда, уход)" FontFamily="MontserratBold" FontSize="13" TextColor="#166534" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <Border BackgroundColor="#DCFCE7" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="-10" FontFamily="MontserratBold" FontSize="13" TextColor="#166534" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetObligMinus"/></Border.GestureRecognizers>
                                        </Border>
                                        <Label x:Name="LblBudgetObligVal" Grid.Column="1" Text="250 монет" FontFamily="MontserratBold" FontSize="18" TextColor="#166534" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Grid.Column="2" BackgroundColor="#DCFCE7" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="+10" FontFamily="MontserratBold" FontSize="13" TextColor="#166534" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetObligPlus"/></Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Конверт 2: Желания -->
                            <Border BackgroundColor="#FDF2F8" Stroke="#FBCFE8" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Border BackgroundColor="#9D174D" StrokeShape="RoundRectangle 6" WidthRequest="26" HeightRequest="26" Padding="4" VerticalOptions="Center">
                                            <Image Source="ic_stat_mood.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="2. Желания и радости (игры, сладости)" FontFamily="MontserratBold" FontSize="13" TextColor="#9D174D" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <Border BackgroundColor="#FCE7F3" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="-10" FontFamily="MontserratBold" FontSize="13" TextColor="#9D174D" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetDiscMinus"/></Border.GestureRecognizers>
                                        </Border>
                                        <Label x:Name="LblBudgetDiscVal" Grid.Column="1" Text="150 монет" FontFamily="MontserratBold" FontSize="18" TextColor="#9D174D" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Grid.Column="2" BackgroundColor="#FCE7F3" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="+10" FontFamily="MontserratBold" FontSize="13" TextColor="#9D174D" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetDiscPlus"/></Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Конверт 3: Сбережения -->
                            <Border BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Border BackgroundColor="#1E40AF" StrokeShape="RoundRectangle 6" WidthRequest="26" HeightRequest="26" Padding="4" VerticalOptions="Center">
                                            <Image Source="ic_stat_savings.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="3. Сбережения (в копилку на цель)" FontFamily="MontserratBold" FontSize="13" TextColor="#1E40AF" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <Border BackgroundColor="#DBEAFE" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="-10" FontFamily="MontserratBold" FontSize="13" TextColor="#1E40AF" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetSavMinus"/></Border.GestureRecognizers>
                                        </Border>
                                        <Label x:Name="LblBudgetSavVal" Grid.Column="1" Text="100 монет" FontFamily="MontserratBold" FontSize="18" TextColor="#1E40AF" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Grid.Column="2" BackgroundColor="#DBEAFE" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="+10" FontFamily="MontserratBold" FontSize="13" TextColor="#1E40AF" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetSavPlus"/></Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="Совет Финни: Правило 50/30/20 помогает копить без стресса!" FontFamily="MontserratMedium" FontSize="11" TextColor="#6B7280" HorizontalTextAlignment="Center"/>

                            <!-- Плашка обратной связи / подтверждения плана -->
                            <Border x:Name="BorderBudgetAlert"
                                    IsVisible="False"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Image x:Name="ImgBudgetAlert" Source="ic_stat_balance.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                                    <Label x:Name="LblBudgetAlertText" Grid.Column="1" FontFamily="MontserratBold" FontSize="12" LineBreakMode="WordWrap" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <!-- Кнопка утвердить план -->
                            <Border x:Name="BtnSaveBudgetPlan" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="48" InputTransparent="False">
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="ic_shield.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                    <Label x:Name="LblSaveBudgetPlan" Text="Утвердить план бюджета" TextColor="White" FontFamily="MontserratBold" FontSize="14" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveBudgetPlanClicked"/></Border.GestureRecognizers>
                            </Border>

                            <!-- Кнопка сравнить план и факт -->
                            <Border BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="44" InputTransparent="False">
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="ic_stat_balance.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                    <Label x:Name="LblComparePlanFactButton" Text="Сравнить План и Факт" TextColor="#520978" FontFamily="MontserratBold" FontSize="13" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShowPlanFactClicked"/></Border.GestureRecognizers>
                            </Border>

                            <!-- Интерактивная карточка сравнения: План vs Факт -->
                            <Border x:Name="BorderPlanFactCard"
                                    IsVisible="False"
                                    BackgroundColor="#F8F7FD"
                                    Stroke="#8A83D1"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,10">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Label Text="Сравнение: План vs Факт" FontFamily="MontserratBold" FontSize="12" TextColor="#520978" VerticalOptions="Center"/>
                                        <Border Grid.Column="1" BackgroundColor="#EDE9FE" StrokeShape="RoundRectangle 10" Padding="8,3" VerticalOptions="Center">
                                            <Label x:Name="LblPlanFactStatusBadge" Text="В норме" FontFamily="MontserratBold" FontSize="10" TextColor="#520978"/>
                                        </Border>
                                    </Grid>

                                    <!-- Строка 1: Обязательные -->
                                    <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <BoxView Grid.Column="0" Color="#10B981" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Обязательные:" FontFamily="MontserratMedium" FontSize="11" TextColor="#374151" VerticalOptions="Center"/>
                                            <Label x:Name="LblPlanFactOblig" Grid.Column="2" Text="250 / 120 м." FontFamily="MontserratBold" FontSize="11" TextColor="#166534" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Строка 2: Желания -->
                                    <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <BoxView Grid.Column="0" Color="#8B5CF6" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Желания:" FontFamily="MontserratMedium" FontSize="11" TextColor="#374151" VerticalOptions="Center"/>
                                            <Label x:Name="LblPlanFactDisc" Grid.Column="2" Text="150 / 80 м." FontFamily="MontserratBold" FontSize="11" TextColor="#9D174D" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Строка 3: Копилка -->
                                    <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <BoxView Grid.Column="0" Color="#F59E0B" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="В копилку:" FontFamily="MontserratMedium" FontSize="11" TextColor="#374151" VerticalOptions="Center"/>
                                            <Label x:Name="LblPlanFactSav" Grid.Column="2" Text="100 / 100 м." FontFamily="MontserratBold" FontSize="11" TextColor="#1E40AF" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <Label x:Name="LblPlanFactAdvice" Text="Совет: Отличная дисциплина! Траты не превышают план." FontFamily="MontserratMedium" FontSize="11" TextColor="#4B5563" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- B. МОДАЛКА: ЗАДАНИЯ И КВИЗ -->
                        <VerticalStackLayout x:Name="PanelTasks" Spacing="12" IsVisible="False">
                            <Border BackgroundColor="#FFF1F2" Stroke="#FECDD3" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8,4" HorizontalOptions="Start">
                                <Label x:Name="LblTaskTopic" Text="Тема: Планирование бюджета" FontFamily="MontserratBold" FontSize="11" TextColor="#E11D48"/>
                            </Border>

                            <Label x:Name="LblTaskSituation"
                                   Text="Ситуация..."
                                   FontFamily="MontserratMedium"
                                   FontSize="13"
                                   TextColor="#1F2937"
                                   LineBreakMode="WordWrap"/>

                            <!-- Варианты ответа -->
                            <VerticalStackLayout x:Name="TaskOptionsContainer" Spacing="8"/>

                            <!-- Обратная связь -->
                            <Border x:Name="TaskFeedbackBorder" BackgroundColor="#F0FDF4" Stroke="#86EFAC" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12" IsVisible="False">
                                <Label x:Name="LblTaskFeedback" Text="Объяснение" FontFamily="MontserratMedium" FontSize="12" TextColor="#166534" LineBreakMode="WordWrap"/>
                            </Border>

                            <Border BackgroundColor="#FF0053" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="46" InputTransparent="False">
                                <Label Text="Следующее задание ➜" TextColor="White" FontFamily="MontserratBold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNextTaskClicked"/></Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <!-- C. МОДАЛКА: МАГАЗИН ЗАБОТЫ -->
                        <VerticalStackLayout x:Name="PanelShop" Spacing="10" IsVisible="False">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Border BackgroundColor="#520978" StrokeShape="RoundRectangle 6" WidthRequest="26" HeightRequest="26" Padding="4" VerticalOptions="Center">
                                    <Image Source="ic_stat_balance.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label x:Name="LblShopBalance" Text="Доступно: 400 монет" FontFamily="MontserratBold" FontSize="14" TextColor="#520978" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Border x:Name="BtnShopTabOblig" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                                        <Image Source="ic_stat_hunger.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" InputTransparent="True"/>
                                        <Label x:Name="LblShopTabOblig" Text="Еда" TextColor="White" FontFamily="MontserratBold" FontSize="11" VerticalOptions="Center" InputTransparent="True"/>
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShopTabObligClicked"/></Border.GestureRecognizers>
                                </Border>

                                <Border x:Name="BtnShopTabDisc" Grid.Column="1" BackgroundColor="#E5E7EB" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                                        <Image Source="ic_stat_mood.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" InputTransparent="True"/>
                                        <Label x:Name="LblShopTabDisc" Text="Игры" TextColor="#4B5563" FontFamily="MontserratBold" FontSize="11" VerticalOptions="Center" InputTransparent="True"/>
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShopTabDiscClicked"/></Border.GestureRecognizers>
                                </Border>

                                <Border x:Name="BtnShopTabDecor" Grid.Column="2" BackgroundColor="#E5E7EB" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                                        <Image Source="ic_customizer.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" InputTransparent="True"/>
                                        <Label x:Name="LblShopTabDecor" Text="Мебель" TextColor="#4B5563" FontFamily="MontserratBold" FontSize="11" VerticalOptions="Center" InputTransparent="True"/>
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShopTabDecorClicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <!-- Контейнер товаров -->
                            <VerticalStackLayout x:Name="ShopItemsContainer" Spacing="8"/>
                        </VerticalStackLayout>

                        <!-- D. МОДАЛКА: КОПИЛКА И ЦЕЛИ -->
                        <VerticalStackLayout x:Name="PanelGoals" Spacing="12" IsVisible="False">
                            <!-- Обучающий баннер о целях накоплений -->
                            <Border BackgroundColor="#F3E8FF" Stroke="#D8B4FE" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Image Source="ic_nav_goals.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Цели накоплений — твои мечты! Выбирай готовую цель из каталога ниже или создай свою. Пополняй копилку в каждом периоде и наблюдай за ростом!"
                                           FontFamily="MontserratMedium"
                                           FontSize="11"
                                           TextColor="#520978"
                                           LineBreakMode="WordWrap"/>
                                </Grid>
                            </Border>

                            <!-- Карточка текущей выбранной цели -->
                            <Border BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Image x:Name="ImgModalCurrentGoal" Source="ic_goal_scooter.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="LblModalGoalTitle" Text="Спортивный трюковой самокат" TextColor="White" FontFamily="MontserratBold" FontSize="14" VerticalOptions="Center"/>
