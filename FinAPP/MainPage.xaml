                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#2563EB" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label Text="Синий" TextColor="White" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOutfitBlueClicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="#E11D48" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label Text="Рубиновый" TextColor="White" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOutfitRubyClicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <Label Text="Головной убор / Аксессуар:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937" Margin="0,4,0,0"/>
