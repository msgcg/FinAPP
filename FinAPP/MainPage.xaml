                                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label Text="🚫 Без аксессуара" TextColor="#520978" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccNoneClicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label Text="🕶️ Очки инвестора" TextColor="#520978" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccSunglassesClicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label Text="🎓 Шапочка экономиста" TextColor="#520978" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccAcademicClicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label Text="👑 Корона сбережений" TextColor="#520978" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccCrownClicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <Label Text="Имя питомца:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry x:Name="EntryPetName" Placeholder="Имя котика" FontSize="14" FontFamily="MontserratMedium"/>
                                <Border Grid.Column="1" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="42" InputTransparent="False">
                                    <Label Text="OK" TextColor="White" FontFamily="MontserratBold" FontSize="13" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSavePetNameClicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </Border>
    </Grid>

</Grid>
</ContentPage>