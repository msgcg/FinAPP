                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                        <Switch x:Name="SwitchQuickSfx" Grid.Column="1" Toggled="OnSfxToggled" OnColor="#520978" VerticalOptions="Center"/>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#E5E7EB"/>

                                    <!-- Тумблер музыки BGM -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                            <Border BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                                <Image x:Name="ImgIconMusic" Source="ic_music_on.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                <Label Text="Фоновая музыка" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937"/>
                                                <Label Text="Спокойная мелодия игрового процесса" FontFamily="MontserratMedium" FontSize="11" TextColor="#6B7280"/>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                        <Switch x:Name="SwitchQuickMusic" Grid.Column="1" Toggled="OnMusicToggled" OnColor="#520978" VerticalOptions="Center"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </Border>
    </Grid>

    <!-- ========================================================================= -->
    <!-- МОДАЛЬНОЕ ОКНО РЕЗУЛЬТАТА ЗАДАНИЯ (ПРАЗДНИЧНЫЙ / ПЕЧАЛЬНЫЙ СТИЛЬ)        -->
    <!-- ========================================================================= -->
    <Grid x:Name="ModalTaskResult"
          IsVisible="False"
          BackgroundColor="#CC090214"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          ZIndex="130">

        <Border x:Name="TaskResultCard"
                StrokeThickness="2.5"
                StrokeShape="RoundRectangle 26"
                Padding="0"
                Margin="16"
                MaximumWidthRequest="390"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.Shadow>
                <Shadow x:Name="ShadowTaskResult" Brush="#10B981" Offset="0,6" Radius="24" Opacity="0.4"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">
                
                <!-- Яркий анимированный/градиентный заголовок (шейдер-эффект) -->
                <Border x:Name="HeaderTaskResult"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24,24,0,0"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Image x:Name="ImgTaskResultIcon"
                               Source="ic_gift.png"
                               WidthRequest="32"
                               HeightRequest="32"
                               HorizontalOptions="Center"/>
                        <Label x:Name="LblTaskResultTitle"
                               Text="УРА! ПРАВИЛЬНЫЙ ОТВЕТ!"
                               FontFamily="MontserratBold"
                               FontSize="16"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"/>
                        <Border x:Name="BadgeTaskResultReward"
                                BackgroundColor="#FEF08A"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,3"
                                HorizontalOptions="Center">
                            <Label x:Name="LblTaskResultReward"
                                   Text="+50 монет на баланс!"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   TextColor="#854D0E"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Основной контент: Финни слева + Окно мудрости/совета справа -->
                <VerticalStackLayout Padding="14,14" Spacing="14" BackgroundColor="White">
                    
                    <!-- Сетка: Финни слева + Карточка мудрости/совета справа -->
                    <Grid ColumnDefinitions="130,*" ColumnSpacing="10" VerticalOptions="Center">
                        <!-- Анимированный Финни (слева) -->
                        <WebView x:Name="WvTaskResultFinny"
                                 Grid.Column="0"
                                 HeightRequest="155"
                                 WidthRequest="130"
                                 BackgroundColor="Transparent"
                                 InputTransparent="True"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center"
                                 Margin="-14,0,0,0"/>

                        <!-- Карточка с разбором и пояснением финансовой мудрости (справа от Финни) -->
                        <Border x:Name="BorderTaskResultExplanation"
                                Grid.Column="1"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,10"
                                VerticalOptions="Center">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="LblTaskResultExplanationHeader"
                                       Text="Мудрость Финни:"
                                       FontFamily="MontserratBold"
                                       FontSize="12"
                                       TextColor="#059669"/>
                                <Label x:Name="LblTaskResultExplanation"
                                       Text="Объяснение..."
                                       FontFamily="MontserratMedium"
                                       FontSize="12"
                                       TextColor="#065F46"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Кнопки действий -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border x:Name="BtnTaskResultTryAgain"
                                BackgroundColor="#F3F4F6"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                HeightRequest="44"
                                InputTransparent="False"
                                IsVisible="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTaskResultTryAgainClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="Попробовать ещё"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   TextColor="#374151"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Border x:Name="BtnTaskResultNext"
                                Grid.Column="1"
                                BackgroundColor="#10B981"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                HeightRequest="44"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTaskResultNextClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="LblTaskResultNext"
                                   Text="Дальше ➜"
                                   FontFamily="MontserratBold"
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>

    <!-- ========================================================================= -->
    <!-- МОДАЛЬНОЕ ОКНО ИНТЕРАКТИВНОГО ОНБОРДИНГА (4 ШАГА-КАРТОЧКИ)                -->
    <!-- ========================================================================= -->
    <Grid x:Name="ModalOnboarding"
          IsVisible="False"
          BackgroundColor="#CC090214"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          ZIndex="140">

        <Border x:Name="OnboardingCard"
                BackgroundColor="White"
                Stroke="#8A83D1"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 26"
                Padding="0"
                Margin="18"
                MaximumWidthRequest="390"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.Shadow>
                <Shadow Brush="#520978" Offset="0,8" Radius="24" Opacity="0.35"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">
                <!-- Яркая шапка онбординга -->
                <Border BackgroundColor="#520978"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24,24,0,0"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image Source="ic_speech_bubble.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                            <Label Text="Школа юного финансиста" TextColor="White" FontFamily="MontserratBold" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="LblOnboardingStepBadge" Grid.Column="1" Text="1 из 4" TextColor="#FEF08A" FontFamily="MontserratBold" FontSize="12" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Содержимое слайда -->
                <VerticalStackLayout Padding="20,18" Spacing="16" BackgroundColor="White">
                    <!-- Иконка / иллюстрация слайда -->
                    <Border x:Name="BorderOnboardingIconBg"
                            BackgroundColor="#F3E8FF"
                            StrokeThickness="0"
                            HeightRequest="80"
                            WidthRequest="80"
                            StrokeShape="RoundRectangle 40"
                            HorizontalOptions="Center">
                        <Image x:Name="ImgOnboardingSlide"
                               Source="ic_gift.png"
                               WidthRequest="46"
                               HeightRequest="46"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Текстовое описание -->
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="LblOnboardingSlideTitle"
                               Text="Привет! Я твой кот Финни!"
                               FontFamily="MontserratBold"
                               FontSize="16"
                               TextColor="#310F53"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="LblOnboardingSlideDesc"
                               Text="Добро пожаловать в FinAPP — твой персональный тренажёр финансовой грамотности! Вместе мы научимся планировать бюджет, копить на мечту и принимать умные решения!"
                               FontFamily="MontserratMedium"
                               FontSize="13"
                               TextColor="#4B5563"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <!-- Индикаторы слайдов (точки) -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,4">
                        <Border x:Name="DotStep1" BackgroundColor="#520978" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="0"/>
                        <Border x:Name="DotStep2" BackgroundColor="#E5E7EB" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="0"/>
                        <Border x:Name="DotStep3" BackgroundColor="#E5E7EB" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="0"/>
                        <Border x:Name="DotStep4" BackgroundColor="#E5E7EB" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="0"/>
                    </HorizontalStackLayout>

                    <!-- Кнопки навигации -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <!-- Кнопка Назад -->
                        <Border x:Name="BtnOnboardingBack"
                                BackgroundColor="#F3F4F6"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="44"
                                WidthRequest="75"
                                InputTransparent="False"
                                IsVisible="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOnboardingBackClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="Назад" FontFamily="MontserratBold" FontSize="12" TextColor="#4B5563" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Кнопка Пропустить -->
                        <Label x:Name="BtnOnboardingSkip"
                               Grid.Column="1"
                               Text="Пропустить"
                               FontFamily="MontserratMedium"
                               FontSize="12"
                               TextColor="#9CA3AF"
                               TextDecorations="Underline"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOnboardingSkipClicked"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Кнопка Далее / Начать -->
                        <Border x:Name="BtnOnboardingNext"
                                Grid.Column="2"
                                BackgroundColor="#520978"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="44"
                                Padding="16,0"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOnboardingNextClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="LblOnboardingNext" Text="Далее ➜" FontFamily="MontserratBold" FontSize="13" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>

    <!-- ================================================================= -->
    <!-- СТИЛИЗОВАННЫЙ ДИАЛОГОВЫЙ ОВЕРЛЕЙ (ALERT, CONFIRM, PROMPT, ACTIONSHEET) -->
    <!-- ================================================================= -->
    <Grid x:Name="StylizedDialogOverlay"
          BackgroundColor="#99000000"
          IsVisible="False"
          Opacity="0"
          ZIndex="9500"
          InputTransparent="False">
        <Border x:Name="StylizedDialogCard"
                BackgroundColor="White"
                Stroke="#8A83D1"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 24"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="350"
                Margin="24"
                Padding="20,18">
            <Border.Shadow>
                <Shadow Brush="#520978" Offset="0,6" Radius="20" Opacity="0.25"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">
                <!-- Заголовок и иконка -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Border x:Name="StylizedDialogIconContainer"
                            BackgroundColor="#EDE9FE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="40"
                            HeightRequest="40"
                            VerticalOptions="Center">
                        <Image x:Name="StylizedDialogIcon"
                               Source="ic_stat_balance.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>
                    <Label x:Name="StylizedDialogTitle"
                           Grid.Column="1"
                           Text="Заголовок"
                           FontFamily="MontserratBold"
                           FontSize="15"
                           TextColor="#1F2937"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"/>
                </Grid>

                <!-- Сообщение -->
                <Label x:Name="StylizedDialogMessage"
                       Text="Описание диалога"
                       FontFamily="MontserratMedium"
                       FontSize="13"
                       TextColor="#4B5563"
                       LineBreakMode="WordWrap"/>

                <!-- Поле ввода для Prompt -->
                <Border x:Name="StylizedDialogInputContainer"
                        IsVisible="False"
                        BackgroundColor="#F9FAFB"
                        Stroke="#8A83D1"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,4">
                    <Entry x:Name="StylizedDialogEntry"
                           FontFamily="MontserratBold"
                           FontSize="14"
                           TextColor="#1F2937"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="Transparent"/>
                </Border>

                <!-- Список вариантов для ActionSheet -->
                <ScrollView x:Name="StylizedDialogOptionsScroll"
                            IsVisible="False"
                            MaximumHeightRequest="260"
                            Orientation="Vertical">
                    <VerticalStackLayout x:Name="StylizedDialogOptionsContainer" Spacing="8"/>
                </ScrollView>

                <!-- Кнопки действий (Alert / Confirm / Prompt) -->
                <Grid x:Name="StylizedDialogButtonsGrid"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <!-- Отмена -->
                    <Border x:Name="StylizedDialogBtnCancel"
                            BackgroundColor="#F3F4F6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            HeightRequest="44"
                            InputTransparent="False">
                        <Label x:Name="StylizedDialogLblCancel"
                               Text="Отмена"
                               TextColor="#4B5563"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStylizedDialogCancelClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Подтверждение / ОК -->
                    <Border x:Name="StylizedDialogBtnConfirm"
                            Grid.Column="1"
                            BackgroundColor="#520978"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            HeightRequest="44"
                            InputTransparent="False">
                        <Label x:Name="StylizedDialogLblConfirm"
                               Text="ОК"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStylizedDialogConfirmClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>

    <!-- Оверлей для анимации рассыпания частиц при покупках и достижении целей -->
    <Grid x:Name="ParticleOverlayGrid" InputTransparent="True" ZIndex="9999" IsVisible="True"/>

</Grid>
</ContentPage>