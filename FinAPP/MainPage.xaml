                                        <Border Grid.Column="2" BackgroundColor="#DCFCE7" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="+10" FontFamily="MontserratBold" FontSize="13" TextColor="#166534" HorizontalOptions="Center" VerticalOptions="Center"/>
