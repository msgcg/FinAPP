                                <Border BackgroundColor="#10B981" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label Text="Изумрудный" TextColor="White" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
