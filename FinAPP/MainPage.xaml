                                <VerticalStackLayout Spacing="6">
                                    <Label x:Name="LblModalGoalTitle" Text="🎯 Трюковой самокат" TextColor="White" FontFamily="MontserratBold" FontSize="15"/>
                                    <Label x:Name="LblModalGoalProgress" Text="Накоплено: 100 / 350 монет (28%)" TextColor="#FFD6E4" FontFamily="MontserratMedium" FontSize="12"/>
                                    <ProgressBar x:Name="BarModalGoal" Progress="0.28" ProgressColor="#FF0053" HeightRequest="8"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="Быстрое пополнение копилки:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937"/>
                            
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="42" InputTransparent="False">
                                    <Label Text="+20 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeposit20Clicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="42" InputTransparent="False">
                                    <Label Text="+50 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeposit50Clicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="42" InputTransparent="False">
                                    <Label Text="+100 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeposit100Clicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <Label Text="Сменить финансовую цель:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937" Margin="0,4,0,0"/>
                            <VerticalStackLayout x:Name="GoalsListContainer" Spacing="6"/>
                        </VerticalStackLayout>

                        <!-- E. МОДАЛКА: СЛОВАРЬ И РОСТ -->
                        <VerticalStackLayout x:Name="PanelGlossary" Spacing="10" IsVisible="False">
                            <Border BackgroundColor="#FEF3C7" Stroke="#FCD34D" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="🌟 Стадии взросления Финни" FontFamily="MontserratBold" FontSize="13" TextColor="#92400E"/>
                                    <Label Text="1. Малыш (1–2 период) 🐾&#10;2. Подросток (3–4 период) 🚀&#10;3. Финни-Мастер (5+ периодов с успешным бюджетом) 👑"
                                           FontFamily="MontserratMedium" FontSize="11" TextColor="#78350F"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="Термины юного финансиста:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937"/>
                            <VerticalStackLayout x:Name="GlossaryTermsContainer" Spacing="8"/>
                        </VerticalStackLayout>

                        <!-- F. МОДАЛКА: РОДИТЕЛЯМ -->
                        <VerticalStackLayout x:Name="PanelParent" Spacing="12" IsVisible="False">
                            <VerticalStackLayout x:Name="ParentPinGate" Spacing="10">
