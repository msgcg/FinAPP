                                <Label Text="✅ Утвердить план бюджета" TextColor="White" FontFamily="MontserratBold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveBudgetPlanClicked"/></Border.GestureRecognizers>
                            </Border>

                            <!-- Кнопка сравнить план и факт -->
                            <Border BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="44" InputTransparent="False">
                                <Label Text="⚖️ Сравнить План и Факт" TextColor="#520978" FontFamily="MontserratBold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShowPlanFactClicked"/></Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <!-- B. МОДАЛКА: ЗАДАНИЯ И КВИЗ -->
                        <VerticalStackLayout x:Name="PanelTasks" Spacing="12" IsVisible="False">
                            <Border BackgroundColor="#FFF1F2" Stroke="#FECDD3" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8,4" HorizontalOptions="Start">
                                <Label x:Name="LblTaskTopic" Text="Тема: Планирование бюджета" FontFamily="MontserratBold" FontSize="11" TextColor="#E11D48"/>
                            </Border>

                            <Label x:Name="LblTaskSituation"
                                   Text="Ситуация..."
                                   FontFamily="MontserratMedium"
                                   FontSize="13"
                                   TextColor="#1F2937"
                                   LineBreakMode="WordWrap"/>

                            <!-- Варианты ответа -->
                            <VerticalStackLayout x:Name="TaskOptionsContainer" Spacing="8"/>

                            <!-- Обратная связь -->
                            <Border x:Name="TaskFeedbackBorder" BackgroundColor="#F0FDF4" Stroke="#86EFAC" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12" IsVisible="False">
                                <Label x:Name="LblTaskFeedback" Text="Объяснение" FontFamily="MontserratMedium" FontSize="12" TextColor="#166534" LineBreakMode="WordWrap"/>
                            </Border>

                            <Border BackgroundColor="#FF0053" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="46" InputTransparent="False">
                                <Label Text="Следующее задание ➡️" TextColor="White" FontFamily="MontserratBold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNextTaskClicked"/></Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <!-- C. МОДАЛКА: МАГАЗИН ЗАБОТЫ -->
                        <VerticalStackLayout x:Name="PanelShop" Spacing="10" IsVisible="False">
                            <Label x:Name="LblShopBalance" Text="💰 Доступно: 400 монет" FontFamily="MontserratBold" FontSize="14" TextColor="#520978"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border x:Name="BtnShopTabOblig" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label x:Name="LblShopTabOblig" Text="🍗 Еда и уход" TextColor="White" FontFamily="MontserratBold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShopTabObligClicked"/></Border.GestureRecognizers>
                                </Border>

                                <Border x:Name="BtnShopTabDisc" BackgroundColor="#E5E7EB" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                    <Label x:Name="LblShopTabDisc" Text="🎮 Игры и радости" TextColor="#4B5563" FontFamily="MontserratBold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShopTabDiscClicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <!-- Контейнер товаров -->
                            <VerticalStackLayout x:Name="ShopItemsContainer" Spacing="8"/>
                        </VerticalStackLayout>

                        <!-- D. МОДАЛКА: КОПИЛКА И ЦЕЛИ -->
                        <VerticalStackLayout x:Name="PanelGoals" Spacing="12" IsVisible="False">
