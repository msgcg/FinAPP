                                        </VerticalStackLayout>
                                        <Switch x:Name="SwitchParentDemoMode" Grid.Column="1" Toggled="OnParentDemoModeToggled" OnColor="#520978" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                                
                                <Border BackgroundColor="#10B981" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" InputTransparent="False">
                                    <Label Text="🎁 Выдать карманные деньги (+100 монет)" TextColor="White" FontFamily="MontserratBold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnParentGiveBonusClicked"/></Border.GestureRecognizers>
                                </Border>

                                <Border BackgroundColor="#EF4444" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="44" InputTransparent="False">
                                    <Label Text="🔄 Сбросить тестовые данные" TextColor="White" FontFamily="MontserratBold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnParentResetDataClicked"/></Border.GestureRecognizers>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- G. МОДАЛКА: КАСТОМИЗАЦИЯ ФИННИ -->
