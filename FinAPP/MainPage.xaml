                                </Border>

                                <Border BackgroundColor="#EF4444" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="44" InputTransparent="False">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image Source="ic_refresh.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                        <Label Text="Сбросить тестовые данные" TextColor="White" FontFamily="MontserratBold" FontSize="13" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnParentResetDataClicked"/></Border.GestureRecognizers>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- H. МОДАЛКА: ДВУСТОРОННИЙ ПЕРЕВОД КОШЕЛЁК <-> КОПИЛКА -->
                        <VerticalStackLayout x:Name="PanelTransfer" Spacing="12" IsVisible="False">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border BackgroundColor="#F8F7FD" Stroke="#8A83D1" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image Source="ic_stat_balance.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                            <Label Text="Кошелёк" FontFamily="MontserratBold" FontSize="11" TextColor="#6B7280"/>
                                        </HorizontalStackLayout>
                                        <Label x:Name="LblTransferWalletVal" Text="400 монет" FontFamily="MontserratBold" FontSize="16" TextColor="#310F53"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1" BackgroundColor="#FDF2F8" Stroke="#F472B6" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image Source="ic_stat_savings.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                            <Label Text="Копилка" FontFamily="MontserratBold" FontSize="11" TextColor="#9D174D"/>
                                        </HorizontalStackLayout>
                                        <Label x:Name="LblTransferSavingsVal" Text="100 монет" FontFamily="MontserratBold" FontSize="16" TextColor="#BE185D"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Переключатель направления -->
                            <Border BackgroundColor="#F3F4F6" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                    <Border x:Name="BtnTransferModeSavings" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image Source="ic_stat_savings.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                            <Label x:Name="LblTransferModeSavings" Text="В копилку" TextColor="White" FontFamily="MontserratBold" FontSize="12" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransferModeSavingsClicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border x:Name="BtnTransferModeWallet" Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image Source="ic_stat_balance.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                            <Label x:Name="LblTransferModeWallet" Text="В кошелёк" TextColor="#6B7280" FontFamily="MontserratMedium" FontSize="12" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransferModeWalletClicked"/></Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>

                            <Label x:Name="LblTransferHint" Text="Пополнение копилки приближает цель и радует Финни!" FontFamily="MontserratMedium" FontSize="12" TextColor="#6B7280"/>

                            <!-- Фиксированные кнопки перевода -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" InputTransparent="False">
                                    <Label x:Name="LblTransferBtn1" Text="+20 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransferBtn1Clicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" InputTransparent="False">
                                    <Label x:Name="LblTransferBtn2" Text="+50 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransferBtn2Clicked"/></Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" InputTransparent="False">
                                    <Label x:Name="LblTransferBtn3" Text="+100 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransferBtn3Clicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <!-- Предупреждение/статус -->
                            <Border x:Name="BorderTransferAlert" BackgroundColor="#FEF3C7" Stroke="#FCD34D" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10" IsVisible="False">
                                <Label x:Name="LblTransferAlert" Text="Инфо..." FontFamily="MontserratMedium" FontSize="11" TextColor="#92400E"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- G. МОДАЛКА: КАСТОМИЗАЦИЯ ФИННИ -->
                        <VerticalStackLayout x:Name="PanelCustomizer" Spacing="12" IsVisible="False">
                            <Label Text="Сменная платформа под лапками:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937"/>
                            
                            <!-- 5 платформ / пьедесталов -->
                            <VerticalStackLayout Spacing="8">
                                <!-- 1. Цветочная полянка -->
                                <Border x:Name="BtnPlatformFlowers" BackgroundColor="#F0FDF4" Stroke="#86EFAC" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,10" InputTransparent="False">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlatformFlowersClicked"/></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="#2E7D32" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                            <Label Text="✤" TextColor="#E8F5E9" FontFamily="MontserratBold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Цветочная полянка" FontFamily="MontserratBold" FontSize="12" TextColor="#166534"/>
                                            <Label Text="Весенний зелёный газон с цветами" FontFamily="MontserratMedium" FontSize="10" TextColor="#4B5563"/>
                                        </VerticalStackLayout>
                                        <Border x:Name="BadgePlatformFlowers" Grid.Column="2" BackgroundColor="#22C55E" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" VerticalOptions="Center">
                                            <Label Text="Активно" TextColor="White" FontFamily="MontserratBold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 2. Звёздная дорожка -->
                                <Border x:Name="BtnPlatformStars" BackgroundColor="#FEFCE8" Stroke="#FDE047" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,10" InputTransparent="False">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlatformStarsClicked"/></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="#F57F17" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                            <Label Text="★" TextColor="#FFF8E1" FontFamily="MontserratBold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Звёздная дорожка" FontFamily="MontserratBold" FontSize="12" TextColor="#854D0E"/>
                                            <Label Text="Золотой пьедестал успеха" FontFamily="MontserratMedium" FontSize="10" TextColor="#4B5563"/>
                                        </VerticalStackLayout>
                                        <Border x:Name="BadgePlatformStars" Grid.Column="2" BackgroundColor="#EAB308" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" VerticalOptions="Center" IsVisible="False">
                                            <Label Text="Активно" TextColor="White" FontFamily="MontserratBold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 3. Изумрудный кристалл -->
                                <Border x:Name="BtnPlatformEmerald" BackgroundColor="#ECFDF5" Stroke="#6EE7B7" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,10" InputTransparent="False">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlatformEmeraldClicked"/></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="#00796B" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                            <Label Text="◆" TextColor="#E0F2F1" FontFamily="MontserratBold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Изумрудный кристалл" FontFamily="MontserratBold" FontSize="12" TextColor="#065F46"/>
                                            <Label Text="Неоновое свечение богатства" FontFamily="MontserratMedium" FontSize="10" TextColor="#4B5563"/>
                                        </VerticalStackLayout>
                                        <Border x:Name="BadgePlatformEmerald" Grid.Column="2" BackgroundColor="#10B981" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" VerticalOptions="Center" IsVisible="False">
                                            <Label Text="Активно" TextColor="White" FontFamily="MontserratBold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 4. Космический неон -->
                                <Border x:Name="BtnPlatformCosmic" BackgroundColor="#F5F3FF" Stroke="#C4B5FD" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,10" InputTransparent="False">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlatformCosmicClicked"/></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="#4A148C" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                            <Label Text="✦" TextColor="#EDE7F6" FontFamily="MontserratBold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Космический неон" FontFamily="MontserratBold" FontSize="12" TextColor="#5B21B6"/>
                                            <Label Text="Фиолетово-синий кибер-подиум" FontFamily="MontserratMedium" FontSize="10" TextColor="#4B5563"/>
                                        </VerticalStackLayout>
                                        <Border x:Name="BadgePlatformCosmic" Grid.Column="2" BackgroundColor="#8B5CF6" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" VerticalOptions="Center" IsVisible="False">
                                            <Label Text="Активно" TextColor="White" FontFamily="MontserratBold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 5. Облако накоплений -->
                                <Border x:Name="BtnPlatformCloud" BackgroundColor="#F0F9FF" Stroke="#BAE6FD" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,10" InputTransparent="False">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlatformCloudClicked"/></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="#0288D1" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                            <Label Text="☁" TextColor="#F5FBFF" FontFamily="MontserratBold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Облако накоплений" FontFamily="MontserratBold" FontSize="12" TextColor="#075985"/>
                                            <Label Text="Воздушный небесно-голубой пьедестал" FontFamily="MontserratMedium" FontSize="10" TextColor="#4B5563"/>
                                        </VerticalStackLayout>
                                        <Border x:Name="BadgePlatformCloud" Grid.Column="2" BackgroundColor="#0EA5E9" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" VerticalOptions="Center" IsVisible="False">
                                            <Label Text="Активно" TextColor="White" FontFamily="MontserratBold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Label Text="Имя питомца:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry x:Name="EntryPetName" Placeholder="Имя котика" FontSize="14" FontFamily="MontserratMedium"/>
                                <Border Grid.Column="1" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="42" InputTransparent="False">
                                    <Label Text="OK" TextColor="White" FontFamily="MontserratBold" FontSize="13" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSavePetNameClicked"/></Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </Border>
    </Grid>

    <!-- ========================================================================= -->
    <!-- МОДАЛЬНОЕ ОКНО РЕЗУЛЬТАТА ЗАДАНИЯ (ПРАЗДНИЧНЫЙ / ПЕЧАЛЬНЫЙ СТИЛЬ)        -->
    <!-- ========================================================================= -->
    <Grid x:Name="ModalTaskResult"
          IsVisible="False"
          BackgroundColor="#CC090214"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          ZIndex="130">

        <Border x:Name="TaskResultCard"
                StrokeThickness="2.5"
                StrokeShape="RoundRectangle 26"
                Padding="0"
                Margin="20"
                MaximumWidthRequest="360"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.Shadow>
                <Shadow x:Name="ShadowTaskResult" Brush="#10B981" Offset="0,6" Radius="24" Opacity="0.4"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">
                
                <!-- Яркий анимированный/градиентный заголовок (шейдер-эффект) -->
                <Border x:Name="HeaderTaskResult"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24,24,0,0"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Image x:Name="ImgTaskResultIcon"
                               Source="ic_gift.png"
                               WidthRequest="32"
                               HeightRequest="32"
                               HorizontalOptions="Center"/>
                        <Label x:Name="LblTaskResultTitle"
                               Text="УРА! ПРАВИЛЬНЫЙ ОТВЕТ!"
                               FontFamily="MontserratBold"
                               FontSize="16"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"/>
                        <Border x:Name="BadgeTaskResultReward"
                                BackgroundColor="#FEF08A"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,3"
                                HorizontalOptions="Center">
                            <Label x:Name="LblTaskResultReward"
                                   Text="+50 монет на баланс!"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   TextColor="#854D0E"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Основной контент: анимированный Финни и пояснение -->
                <VerticalStackLayout Padding="16,14" Spacing="12" BackgroundColor="White">
                    
                    <!-- Анимированный Финни (WebView с _proud.gif или _sad.gif) -->
                    <WebView x:Name="WvTaskResultFinny"
                             HeightRequest="160"
                             WidthRequest="160"
                             BackgroundColor="Transparent"
                             InputTransparent="True"
                             HorizontalOptions="Start"
                             Margin="-16,0,0,0"/>

                    <!-- Карточка с разбором и пояснением финансовой мудрости -->
                    <Border x:Name="BorderTaskResultExplanation"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14"
                            Padding="12,10">
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="LblTaskResultExplanationHeader"
                                   Text="Мудрость Финни:"
                                   FontFamily="MontserratBold"
                                   FontSize="12"/>
                            <Label x:Name="LblTaskResultExplanation"
                                   Text="Объяснение..."
                                   FontFamily="MontserratMedium"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Кнопки действий -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border x:Name="BtnTaskResultTryAgain"
                                BackgroundColor="#F3F4F6"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                HeightRequest="44"
                                InputTransparent="False"
                                IsVisible="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTaskResultTryAgainClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="Попробовать ещё"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   TextColor="#374151"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Border x:Name="BtnTaskResultNext"
                                Grid.Column="1"
                                BackgroundColor="#10B981"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                HeightRequest="44"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTaskResultNextClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="LblTaskResultNext"
                                   Text="Дальше ➜"
                                   FontFamily="MontserratBold"
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>

</Grid>
</ContentPage>