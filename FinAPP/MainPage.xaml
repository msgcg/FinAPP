<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:FinAPP.Views.Components"
             x:Class="FinAPP.MainPage"
             BackgroundColor="#F5F6FA"
             Title="FinAPP">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="14">

            <!-- ВЕРХНЯЯ ПАНЕЛЬ: Брендинг, Демо-режим и доступность -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="FinAPP"
                           FontFamily="MontserratBold"
                           FontSize="22"
                           TextColor="#520978"
                           VerticalOptions="Center"/>
                    <Border x:Name="BadgeDemo"
                            IsVisible="False"
                            BackgroundColor="#FF0053"
                            StrokeThickness="0"
                            Padding="8,2"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Center">
                        <Label Text="ДЕМО"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="11"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Игровой период и доступность (анимации, кастомизация) -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Border x:Name="BtnAnimToggle"
                            BackgroundColor="#EBE9F8"
                            StrokeThickness="0"
                            HeightRequest="42"
                            WidthRequest="42"
                            StrokeShape="RoundRectangle 21"
                            InputTransparent="False">
                        <Label x:Name="LblAnimIcon"
                               Text="🎬"
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAnimToggleClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Border x:Name="BtnCustomizer"
                            BackgroundColor="#EBE9F8"
                            StrokeThickness="0"
                            HeightRequest="42"
                            WidthRequest="42"
                            StrokeShape="RoundRectangle 21"
                            InputTransparent="False">
                        <Label Text="🎨"
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomizerClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ТУМБЛЕР ВОЗРАСТА (7–8 ЛЕТ / 9–11 ЛЕТ) -->
            <Border BackgroundColor="#F3F0FA"
                    Stroke="#D8D2E8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="3"
                    HorizontalOptions="Center"
                    Margin="0, 0, 0, 4">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                    <!-- 7–8 лет -->
                    <Border x:Name="BtnAgeJunior"
                            Grid.Column="0"
                            BackgroundColor="#520978"
                            StrokeThickness="0"
                            Padding="14,6"
                            StrokeShape="RoundRectangle 12"
                            InputTransparent="False">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🧒" FontSize="14" VerticalOptions="Center"/>
                            <Label x:Name="LblAgeJunior"
                                   Text="7–8 лет"
                                   TextColor="White"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgeJuniorClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- 9–11 лет -->
                    <Border x:Name="BtnAgeSenior"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="14,6"
                            StrokeShape="RoundRectangle 12"
                            InputTransparent="False">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🧑" FontSize="14" VerticalOptions="Center"/>
                            <Label x:Name="LblAgeSenior"
                                   Text="9–11 лет"
                                   TextColor="#6B7280"
                                   FontFamily="MontserratMedium"
                                   FontSize="12"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgeSeniorClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- КАРТОЧКА ПИТОМЦА И ЕГО СОСТОЯНИЯ -->
            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="14,12">
                <Border.Shadow>
                    <Shadow Brush="#520978" Offset="0,4" Radius="12" Opacity="0.08"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    
                    <!-- Заголовок карточки и индикатор периода -->
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🐱" FontSize="16" VerticalOptions="Center"/>
                            <Label x:Name="LblPetHeader"
                                   Text="Питомец Финни"
                                   FontFamily="MontserratBold"
                                   FontSize="16"
                                   TextColor="#1C1D22"/>
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#F3E8FF"
                                Stroke="#8A83D1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,3">
                            <Label x:Name="LblPeriodHeader"
                                   Text="Период #1"
                                   FontFamily="MontserratBold"
                                   FontSize="12"
                                   TextColor="#520978"/>
                        </Border>
                    </Grid>

                    <!-- Компонент котика со слоями и анимацией -->
                    <comp:FinnyPetView x:Name="PetView" HorizontalOptions="Center"/>

                    <!-- Индикаторы сытости и настроения (ТЗ п. 2.5.3) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                        
                        <!-- Сытость (зависит от обязательных расходов) -->
                        <Border BackgroundColor="#F0FDF4"
                                Stroke="#86EFAC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,8">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="🍗 Сытость"
                                           FontFamily="MontserratBold"
                                           FontSize="13"
                                           TextColor="#166534"/>
                                    <Label x:Name="LblHungerVal"
                                           Grid.Column="1"
                                           Text="90%"
                                           FontFamily="MontserratBold"
                                           FontSize="13"
                                           TextColor="#166534"/>
                                </Grid>
                                <ProgressBar x:Name="BarHunger"
                                             Progress="0.9"
                                             ProgressColor="#10B981"
                                             HeightRequest="8"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Настроение (зависит от желаний и заданий) -->
                        <Border BackgroundColor="#FDF2F8"
                                Stroke="#FBCFE8"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,8">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="💖 Настроение"
                                           FontFamily="MontserratBold"
                                           FontSize="13"
                                           TextColor="#9D174D"/>
                                    <Label x:Name="LblMoodVal"
                                           Grid.Column="1"
                                           Text="90%"
                                           FontFamily="MontserratBold"
                                           FontSize="13"
                                           TextColor="#9D174D"/>
                                </Grid>
                                <ProgressBar x:Name="BarMood"
                                             Progress="0.9"
                                             ProgressColor="#FC3777"
                                             HeightRequest="8"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Текстовое объяснение причины состояния (ТЗ п. 2.5.10) -->
                    <Label x:Name="LblStatusExplanation"
                           Text="Финни сыт, доволен и гордится твоим грамотным бюджетом!"
                           FontFamily="MontserratMedium"
                           FontSize="12"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center"
                           Margin="0,2,0,0"/>

                </VerticalStackLayout>
            </Border>

            <!-- ГЛАВНАЯ ФИНАНСОВАЯ КАРТОЧКА (Баланс, Копилка, Цель) -->
            <Border BackgroundColor="#520978"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="16,14">
                <Border.Shadow>
                    <Shadow Brush="#520978" Offset="0,6" Radius="14" Opacity="0.25"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    
                    <!-- Баланс и Копилка -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        
                        <!-- Доступный баланс -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="💰 ДОСТУПНО"
                                   TextColor="#FFD6E4"
                                   FontFamily="MontserratBold"
                                   FontSize="11"/>
                            <Label x:Name="LblBalance"
                                   Text="400 монет"
                                   TextColor="White"
                                   FontFamily="MontserratBold"
                                   FontSize="20"/>
                        </VerticalStackLayout>

                        <!-- Накопления в копилке -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="🏦 В КОПИЛКЕ"
                                   TextColor="#FFD6E4"
                                   FontFamily="MontserratBold"
                                   FontSize="11"/>
                            <Label x:Name="LblSavings"
                                   Text="100 монет"
                                   TextColor="#FFD6E4"
                                   FontFamily="MontserratBold"
                                   FontSize="20"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#702299" Margin="0,2"/>

                    <!-- Прогресс финансовой цели (ТЗ п. 2.5.3, 2.5.7) -->
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="LblGoalTitle"
                                   Text="🎯 Цель: Трюковой самокат"
                                   TextColor="White"
                                   FontFamily="MontserratBold"
                                   FontSize="13"/>
                            <Label x:Name="LblGoalProgressText"
                                   Grid.Column="1"
                                   Text="100 / 350 (28%)"
                                   TextColor="#FFD6E4"
                                   FontFamily="MontserratMedium"
                                   FontSize="12"/>
                        </Grid>

                        <ProgressBar x:Name="BarGoal"
                                     Progress="0.28"
                                     ProgressColor="#FF0053"
                                     HeightRequest="8"/>

                        <Label x:Name="LblGoalEstimatedTime"
                               Text="⏱️ До достижения цели осталось ~5 периодов"
                               TextColor="#FFD6E4"
                               FontFamily="MontserratMedium"
                               FontSize="11"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- БЫСТРАЯ НАВИГАЦИЯ ПО РАЗДЕЛАМ (Кнопки >= 48dp по п. 3.6 ТЗ) -->
            <Label Text="Финансовые действия"
                   FontFamily="MontserratBold"
                   FontSize="16"
                   TextColor="#1C1D22"
                   Margin="4,2,0,0"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">

                <!-- 1. План бюджета -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="📊" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="План бюджета"
                               TextColor="#520978"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBudgetClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 2. Финансовые задания -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="📚" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Задания (+монеты)"
                               TextColor="#FF0053"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTasksClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 3. Магазин -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="🛒" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Магазин заботы"
                               TextColor="#059669"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShopClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 4. Копилка и цели -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="🎯" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Копилка и цели"
                               TextColor="#4F46E5"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoalsClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 5. Словарь и рост -->
                <Border Grid.Row="2" Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="📖" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Словарь и рост"
                               TextColor="#D97706"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGlossaryClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 6. Родителям -->
                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="58"
                        Padding="12,0"
                        InputTransparent="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="🔒" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Родителям"
                               TextColor="#4B5563"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnParentClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- 7. ДЕМО: Следующий период -->
                <Border x:Name="CardDemoNextPeriod"
                        IsVisible="False"
                        Grid.Row="3" Grid.ColumnSpan="2"
                        BackgroundColor="#310F53"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="54"
                        Padding="14,0"
                        InputTransparent="False">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="⏭️" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="ДЕМО: Завершить период и перейти дальше"
                               TextColor="White"
                               FontFamily="MontserratBold"
                               FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextPeriodClicked"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>

            <!-- Подвал с логотипами и статусом -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,10,0,16">
                <Label Text="Департамент финансов Москвы • ЛЦТ 2026"
                       FontFamily="MontserratMedium"
                       FontSize="11"
                       TextColor="#9CA3AF"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <!-- ================================================================= -->
    <!-- ИНТЕРАКТИВНЫЙ ВНУТРИСТРАНИЧНЫЙ МОДАЛЬНЫЙ ОВЕРЛЕЙ (In-Page Modals)  -->
    <!-- ================================================================= -->
    <Grid x:Name="ModalOverlay"
          BackgroundColor="#AA000000"
          IsVisible="False"
          Opacity="0"
          InputTransparent="False">

        <!-- Клик по затемненной подложке закрывает окно -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCloseModalClicked"/>
        </Grid.GestureRecognizers>

        <!-- Центральная карточка модалки -->
        <Border x:Name="ModalCard"
                BackgroundColor="White"
                Stroke="#8A83D1"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 24"
                Margin="16,24"
                Padding="18,16"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="440"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">

                <!-- Шапка модального окна -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label x:Name="LblModalHeader"
                           Text="Модальное окно"
                           FontFamily="MontserratBold"
                           FontSize="17"
                           TextColor="#310F53"
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#F3F4F6"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="34"
                            WidthRequest="34"
                            Padding="0"
                            InputTransparent="False">
                        <Label Text="✕"
                               FontSize="15"
                               FontFamily="MontserratBold"
                               TextColor="#4B5563"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseModalClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="#E5E7EB"/>

                <!-- СКРОЛЛИРУЕМАЯ ОБЛАСТЬ КОНТЕНТА МОДАЛКИ -->
                <ScrollView MaximumHeightRequest="480">
                    <VerticalStackLayout Spacing="12">

                        <!-- A. МОДАЛКА: ПЛАН БЮДЖЕТА (3 КОНВЕРТА) -->
                        <VerticalStackLayout x:Name="PanelBudget" Spacing="12" IsVisible="False">
                            <Border BackgroundColor="#F3E8FF" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="LblBudgetIncome" Text="💰 Доход: 500 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#520978"/>
                                    <Label x:Name="LblBudgetRemaining" Grid.Column="1" Text="Осталось: 0 монет" FontFamily="MontserratBold" FontSize="13" TextColor="#FF0053"/>
                                </Grid>
                            </Border>

                            <!-- Конверт 1: Обязательные -->
                            <Border BackgroundColor="#F0FDF4" Stroke="#86EFAC" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🍗 1. Обязательные расходы (еда, уход)" FontFamily="MontserratBold" FontSize="13" TextColor="#166534"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <Border BackgroundColor="#DCFCE7" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="-10" FontFamily="MontserratBold" FontSize="13" TextColor="#166534" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetObligMinus"/></Border.GestureRecognizers>
                                        </Border>
                                        <Label x:Name="LblBudgetObligVal" Grid.Column="1" Text="250 монет" FontFamily="MontserratBold" FontSize="18" TextColor="#166534" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Grid.Column="2" BackgroundColor="#DCFCE7" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="+10" FontFamily="MontserratBold" FontSize="13" TextColor="#166534" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetObligPlus"/></Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Конверт 2: Желания -->
                            <Border BackgroundColor="#FDF2F8" Stroke="#FBCFE8" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🎮 2. Желания и радости (игры, сладости)" FontFamily="MontserratBold" FontSize="13" TextColor="#9D174D"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <Border BackgroundColor="#FCE7F3" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="-10" FontFamily="MontserratBold" FontSize="13" TextColor="#9D174D" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetDiscMinus"/></Border.GestureRecognizers>
                                        </Border>
                                        <Label x:Name="LblBudgetDiscVal" Grid.Column="1" Text="150 монет" FontFamily="MontserratBold" FontSize="18" TextColor="#9D174D" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Grid.Column="2" BackgroundColor="#FCE7F3" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="+10" FontFamily="MontserratBold" FontSize="13" TextColor="#9D174D" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetDiscPlus"/></Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Конверт 3: Сбережения -->
                            <Border BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🏦 3. Сбережения (в копилку на цель)" FontFamily="MontserratBold" FontSize="13" TextColor="#1E40AF"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <Border BackgroundColor="#DBEAFE" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="-10" FontFamily="MontserratBold" FontSize="13" TextColor="#1E40AF" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetSavMinus"/></Border.GestureRecognizers>
                                        </Border>
                                        <Label x:Name="LblBudgetSavVal" Grid.Column="1" Text="100 монет" FontFamily="MontserratBold" FontSize="18" TextColor="#1E40AF" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Grid.Column="2" BackgroundColor="#DBEAFE" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" InputTransparent="False">
                                            <Label Text="+10" FontFamily="MontserratBold" FontSize="13" TextColor="#1E40AF" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetSavPlus"/></Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="💡 Совет Финни: Правило 50/30/20 помогает копить без стресса!" FontFamily="MontserratMedium" FontSize="11" TextColor="#6B7280" HorizontalTextAlignment="Center"/>

                            <!-- Кнопка утвердить план -->
