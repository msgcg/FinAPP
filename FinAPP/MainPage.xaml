                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnParentStageTeenClicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border x:Name="BtnParentStageMaster" Grid.Column="2" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="38" InputTransparent="False">
                                        <Label x:Name="LblParentStageMaster" Text="3. Мастер" FontFamily="MontserratBold" FontSize="11" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnParentStageMasterClicked"/></Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                                
                                <Border BackgroundColor="#F3E8FF" Stroke="#D8B4FE" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="Демо-режим симуляции" FontFamily="MontserratBold" FontSize="13" TextColor="#520978"/>
