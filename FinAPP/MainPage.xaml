                            <Border BackgroundColor="#F3E8FF" Stroke="#D8B4FE" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Image Source="ic_nav_goals.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Цели накоплений — твои мечты! Выбирай готовую цель из каталога ниже или создай свою. Пополняй копилку в каждом периоде и наблюдай за ростом!"
                                           FontFamily="MontserratMedium"
                                           FontSize="11"
                                           TextColor="#520978"
                                           LineBreakMode="WordWrap"/>
                                </Grid>
                            </Border>

                            <!-- Карточка текущей выбранной цели -->
                            <Border BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Image x:Name="ImgModalCurrentGoal" Source="ic_goal_scooter.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" x:Name="LblModalGoalTitle" Text="Спортивный трюковой самокат" TextColor="White" FontFamily="MontserratBold" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" x:Name="LblModalGoalProgress" Text="100 / 350 монет (28%)" TextColor="#FFD6E4" FontFamily="MontserratMedium" FontSize="12" VerticalOptions="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarModalGoal" Progress="0.28" ProgressColor="#FF0053" HeightRequest="8"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Двустороннее перемещение средств: пополнение и снятие -->
                            <Label Text="Перемещение денег между балансом и копилкой:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937"/>
                            
                            <!-- В копилку -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Положить в копилку (из кошелька):" FontFamily="MontserratMedium" FontSize="11" TextColor="#6B7280"/>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <Label Text="+20 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeposit20Clicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <Label Text="+50 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeposit50Clicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border Grid.Column="2" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <Label Text="+100 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#520978" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeposit100Clicked"/></Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Снять из копилки -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Снять в кошелёк (на текущие расходы):" FontFamily="MontserratMedium" FontSize="11" TextColor="#6B7280"/>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border BackgroundColor="#FEE2E2" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <Label Text="-20 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#B91C1C" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnWithdraw20Clicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#FEE2E2" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <Label Text="-50 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#B91C1C" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnWithdraw50Clicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border Grid.Column="2" BackgroundColor="#FEE2E2" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="40" InputTransparent="False">
                                        <Label Text="-100 монет" FontFamily="MontserratBold" FontSize="12" TextColor="#B91C1C" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnWithdraw100Clicked"/></Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Заголовок каталога и кнопка создания своей цели -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" VerticalOptions="Center">
                                <Label Text="Каталог целей накопления:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6" InputTransparent="False">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Image Source="ic_plus.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                                        <Label Text="Своя цель" TextColor="White" FontFamily="MontserratBold" FontSize="11" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAddCustomGoalClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
