                                <Entry x:Name="EntryParentMathAnswer" Placeholder="Ответ" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="16" FontFamily="MontserratBold"/>
                                <Border BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="44" InputTransparent="False">
                                    <Label Text="Войти в кабинет" TextColor="White" FontFamily="MontserratBold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnParentUnlockClicked"/></Border.GestureRecognizers>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="ParentContent" Spacing="10" IsVisible="False">
                                <Label Text="Аналитика успехов ребенка" FontFamily="MontserratBold" FontSize="14" TextColor="#1F2937"/>
                                <Label x:Name="LblParentStats" Text="Сыграно периодов: 1..." FontFamily="MontserratMedium" FontSize="12" TextColor="#4B5563"/>

                                <Label Text="Возрастная программа обучения:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937" Margin="0,4,0,0"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Border x:Name="BtnParentAgeJunior" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="38" InputTransparent="False">
