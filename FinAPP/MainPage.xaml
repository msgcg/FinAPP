                            <VerticalStackLayout x:Name="ParentPinGate" Spacing="10">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Image Source="ic_shield.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                    <Label Text="Защита для взрослых" FontFamily="MontserratBold" FontSize="14" TextColor="#1F2937" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="Решите пример, чтобы подтвердить, что вы взрослый:" FontFamily="MontserratMedium" FontSize="12" TextColor="#6B7280"/>
