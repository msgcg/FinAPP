                                        <Label x:Name="LblParentAgeSenior" Text="9–11 лет (3–5 кл)" TextColor="#520978" FontFamily="MontserratBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAgeSeniorClicked"/></Border.GestureRecognizers>
                                    </Border>
                                </Grid>

                                <!-- ПРЯМОЙ ПЕРЕКЛЮЧАТЕЛЬ СТАДИЙ ЭВОЛЮЦИИ ФИННИ -->
                                <Label Text="Стадия эволюции Финни (проверка возрастов):" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937" Margin="0,4,0,0"/>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                    <Border x:Name="BtnParentStageBaby" BackgroundColor="#520978" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="38" InputTransparent="False">
