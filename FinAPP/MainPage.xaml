                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnParentStageBabyClicked"/></Border.GestureRecognizers>
                                    </Border>
                                    <Border x:Name="BtnParentStageTeen" Grid.Column="1" BackgroundColor="#EBE9F8" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="38" InputTransparent="False">
