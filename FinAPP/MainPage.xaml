                                        <Label Text="Стадии взросления Финни" FontFamily="MontserratBold" FontSize="13" TextColor="#92400E" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="1. Малыш (1–2 период) — базовые потребности (еда и уход)&#10;2. Подросток (3–4 период) — баланс обязательного и желаний&#10;3. Финни-Мастер (5+ периодов) — грамотные сбережения и финансовая устойчивость"
                                           FontFamily="MontserratMedium" FontSize="11" TextColor="#78350F"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="Термины юного финансиста:" FontFamily="MontserratBold" FontSize="13" TextColor="#1F2937"/>
                            <VerticalStackLayout x:Name="GlossaryTermsContainer" Spacing="8"/>
                        </VerticalStackLayout>

